# Sentry Internal Integration의 client secret (webhook 서명 검증용)
SENTRY_CLIENT_SECRET=
# Discord 채널의 Incoming Webhook URL (채널 설정 > 연동 > 웹후크에서 발급)
DISCORD_WEBHOOK_URL=
# UptimeRobot Discord 연동의 웹훅 주소를 https://<중계기>/uptimerobot/<토큰> 으로 바꿀 때 쓰는 토큰
UPTIMEROBOT_RELAY_TOKEN=
# 아래는 기본값 있음
# PORT=8092
# HOST=127.0.0.1
